---
// Google Analytics 4, gated behind Consent Mode v2 — see
// instructions/CLAUDE EXECUTION PLAN — gnegreiros.md §10 and
// instructions/synthese-phase3-technologie-portfolio.md.
// Consent defaults to "denied" so no cookie is set until the visitor
// accepts via <ConsentBanner>, which is required for Loi 25 (Québec).
const GA_MEASUREMENT_ID = 'G-ETKLB4T5TP';
---

<script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	window.gtag = gtag;

	gtag('consent', 'default', {
		ad_storage: 'denied',
		ad_user_data: 'denied',
		ad_personalization: 'denied',
		analytics_storage: 'denied',
	});

	if (localStorage.getItem('consent-analytics') === 'granted') {
		gtag('consent', 'update', { analytics_storage: 'granted' });
	}

	gtag('js', new Date());
	gtag('config', GA_MEASUREMENT_ID);
</script>
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
