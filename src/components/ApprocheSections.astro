---
import type { ApprocheCopy } from '../content/copy/approche';

interface Props {
	heroTitle: string;
	heroSubtitle?: string;
	copy: ApprocheCopy;
}

const { heroTitle, heroSubtitle, copy } = Astro.props;
---

<section class="page-hero">
	<div class="dot-mark page-hero__mark" aria-hidden="true"></div>
	<h1 class="page-hero__title">{heroTitle}</h1>
	{heroSubtitle && <p class="page-hero__subtitle">{heroSubtitle}</p>}
</section>

<section class="section prose-section">
	<h2 class="section__title">{copy.problemTitle}</h2>
	<p class="section__body">{copy.problemBody}</p>
</section>

<section class="section principles-section">
	<div class="dot-mark principles-section__mark" aria-hidden="true"></div>
	<h2 class="section__title">{copy.principlesTitle}</h2>
	<p class="section__intro">{copy.principlesIntro}</p>
	<div class="principles__grid">
		{copy.principles.map((principle) => (
			<article class="principle">
				<p class="principle__number">{principle.number}</p>
				<h3 class="principle__title">{principle.title}</h3>
				<p class="principle__body">{principle.body}</p>
			</article>
		))}
	</div>
</section>

<section class="section prose-section">
	<h2 class="section__title">{copy.practiceTitle}</h2>
	<p class="section__body">{copy.practiceBody}</p>
</section>

<section class="section prose-section ai-section">
	<div class="dot-mark ai-section__mark" aria-hidden="true"></div>
	<h2 class="section__title">{copy.aiTitle}</h2>
	<p class="section__body">{copy.aiBody}</p>
</section>

<style>
	.dot-mark {
		position: absolute;
		pointer-events: none;
		background-image: radial-gradient(var(--color-text-secondary) 2px, transparent 2px);
		background-size: 14px 14px;
		opacity: 0.2;
	}

	@media (max-width: 1024px) {
		.dot-mark {
			display: none;
		}
	}

	.page-hero {
		position: relative;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 7.5rem 1.5rem 0;
	}

	.page-hero__mark {
		top: 1.5rem;
		right: 1.5rem;
		width: 180px;
		height: 130px;
	}

	.page-hero__title {
		margin: 0 0 1.5rem;
		font-family: var(--font-serif);
		font-size: var(--text-h1);
		line-height: 1.1;
		color: var(--color-text-primary);
	}

	.page-hero__subtitle {
		margin: 0;
		max-width: var(--measure);
		font-family: var(--font-serif);
		font-size: var(--text-lead);
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.section {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: var(--space-section) 1.5rem 0;
	}

	.prose-section {
		position: relative;
	}

	.section__title {
		margin: 0 0 1.5rem;
		max-width: var(--measure);
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		line-height: 1.2;
		color: var(--color-text-primary);
	}

	.section__body,
	.section__intro {
		margin: 0;
		max-width: var(--measure);
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.section__intro {
		margin-bottom: 2rem;
	}

	.principles-section {
		position: relative;
	}

	.principles-section__mark {
		top: 0;
		right: 1.5rem;
		width: 140px;
		height: 100px;
	}

	.principles__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-card-gap);
	}

	.principle {
		border-left: 2px solid var(--color-accent);
		padding: var(--space-card-padding) 0 0 var(--space-card-padding);
	}

	.principle__number {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.08em;
		color: var(--color-text-secondary);
	}

	.principle__title {
		margin: 0 0 0.75rem;
		font-family: var(--font-serif);
		font-size: var(--text-h3);
		line-height: 1.3;
		color: var(--color-text-primary);
	}

	.principle__body {
		margin: 0;
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.ai-section {
		padding-bottom: var(--space-section);
	}

	.ai-section__mark {
		bottom: 1rem;
		right: 1.5rem;
		width: 140px;
		height: 100px;
	}

	@media (max-width: 768px) {
		.principles__grid {
			grid-template-columns: 1fr;
			gap: var(--space-card-gap-mobile);
		}

		.principle {
			padding-left: calc(var(--space-card-padding) - 0.5rem);
		}
	}
</style>
