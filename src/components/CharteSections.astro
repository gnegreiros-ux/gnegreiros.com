---
interface Props {
	heroTitle: string;
	heroSubtitle?: string;
	Content: unknown;
}

const { heroTitle, heroSubtitle, Content } = Astro.props as {
	heroTitle: string;
	heroSubtitle?: string;
	Content: any;
};
---

<section class="page-hero">
	<div class="dot-mark page-hero__mark" aria-hidden="true"></div>
	<h1 class="page-hero__title">{heroTitle}</h1>
	{heroSubtitle && <p class="page-hero__subtitle">{heroSubtitle}</p>}
</section>

<section class="section charte-section">
	<div class="dot-mark charte-section__mark" aria-hidden="true"></div>
	<div class="charte-body">
		<Content />
	</div>
</section>

<style>
	.dot-mark {
		position: absolute;
		pointer-events: none;
		background-image: radial-gradient(var(--color-text-secondary) 2px, transparent 2px);
		background-size: 14px 14px;
		opacity: 0.2;
	}

	@media (max-width: 1024px) {
		.dot-mark {
			display: none;
		}
	}

	.page-hero {
		position: relative;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 7.5rem 1.5rem 0;
	}

	.page-hero__mark {
		top: 1.5rem;
		right: 1.5rem;
		width: 180px;
		height: 130px;
	}

	.page-hero__title {
		margin: 0 0 1.5rem;
		font-family: var(--font-serif);
		font-size: var(--text-h1);
		line-height: 1.1;
		color: var(--color-text-primary);
	}

	.page-hero__subtitle {
		margin: 0;
		max-width: var(--measure);
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.03em;
		color: var(--color-text-secondary);
	}

	.section {
		position: relative;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: var(--space-section) 1.5rem var(--space-section);
	}

	.charte-section__mark {
		top: var(--space-section);
		right: 1.5rem;
		width: 140px;
		height: 100px;
	}

	.charte-body {
		max-width: var(--measure);
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-text-primary);
	}

	.charte-body :global(h2) {
		margin: 3rem 0 1rem;
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		line-height: 1.2;
		color: var(--color-text-primary);
	}

	.charte-body :global(h2:first-child) {
		margin-top: 0;
	}

	.charte-body :global(h3) {
		margin: 2rem 0 0.75rem;
		font-family: var(--font-serif);
		font-size: var(--text-h3);
		line-height: 1.3;
		color: var(--color-text-primary);
	}

	.charte-body :global(p) {
		margin: 0 0 1.25rem;
	}

	.charte-body :global(strong) {
		color: var(--color-text-primary);
	}

	.charte-body :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-decoration-color: var(--color-line);
	}

	.charte-body :global(a:hover),
	.charte-body :global(a:focus-visible) {
		text-decoration-color: currentColor;
	}

	.charte-body :global(ul),
	.charte-body :global(ol) {
		margin: 0 0 1.25rem;
		padding-left: 1.5rem;
	}

	.charte-body :global(li) {
		margin-bottom: 0.5rem;
	}

	.charte-body :global(table) {
		width: 100%;
		margin: 0 0 1.25rem;
		border-collapse: collapse;
		font-size: var(--text-small);
	}

	.charte-body :global(th),
	.charte-body :global(td) {
		padding: 0.625rem 0.75rem;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--color-line);
	}

	.charte-body :global(th) {
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.03em;
		color: var(--color-text-secondary);
	}

	@media (max-width: 640px) {
		.charte-body :global(table) {
			display: block;
			overflow-x: auto;
		}
	}
</style>
