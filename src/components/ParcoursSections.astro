---
import type { ParcoursCopy } from '../content/copy/parcours';

interface Props {
	heroTitle: string;
	heroSubtitle?: string;
	copy: ParcoursCopy;
}

const { heroTitle, heroSubtitle, copy } = Astro.props;
---

<section class="page-hero">
	<div class="dot-mark page-hero__mark" aria-hidden="true"></div>
	<h1 class="page-hero__title">{heroTitle}</h1>
	{heroSubtitle && <p class="page-hero__subtitle">{heroSubtitle}</p>}
</section>

<section class="section engagements-section">
	<div class="dot-mark engagements-section__mark" aria-hidden="true"></div>
	<div class="engagements">
		{copy.engagements.map((engagement) => (
			<article class="engagement">
				<div class="engagement__meta">
					<img class="engagement__logo" src={engagement.logo} alt={engagement.alt} loading="lazy" />
					<p class="engagement__dates">
						{engagement.dates}
						{engagement.current && <span class="engagement__tag">{copy.currentLabel}</span>}
					</p>
				</div>
				<div class="engagement__body">
					<h2 class="engagement__role">{engagement.role}</h2>
					<p class="engagement__desc">{engagement.body}</p>
				</div>
			</article>
		))}
	</div>
</section>

<style>
	.dot-mark {
		position: absolute;
		pointer-events: none;
		background-image: radial-gradient(var(--color-text-secondary) 2px, transparent 2px);
		background-size: 14px 14px;
		opacity: 0.2;
	}

	@media (max-width: 1024px) {
		.dot-mark {
			display: none;
		}
	}

	.page-hero {
		position: relative;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 7.5rem 1.5rem 0;
	}

	.page-hero__mark {
		top: 1.5rem;
		right: 1.5rem;
		width: 180px;
		height: 130px;
	}

	.page-hero__title {
		margin: 0 0 1.5rem;
		max-width: 16ch;
		font-family: var(--font-serif);
		font-size: var(--text-h1);
		line-height: 1.1;
		color: var(--color-text-primary);
	}

	.page-hero__subtitle {
		margin: 0;
		max-width: var(--measure);
		font-family: var(--font-serif);
		font-size: var(--text-lead);
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.section {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: var(--space-section) 1.5rem 0;
	}

	.engagements-section {
		position: relative;
		padding-bottom: var(--space-section);
	}

	.engagements-section__mark {
		top: 0;
		right: 1.5rem;
		width: 160px;
		height: 110px;
	}

	.engagements {
		display: flex;
		flex-direction: column;
		gap: var(--space-card-gap);
	}

	.engagement {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: var(--space-card-padding);
	}

	.engagement:not(:first-child) {
		padding-top: var(--space-card-gap);
		border-top: 1px solid var(--color-line);
	}

	.engagement__meta {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.engagement__logo {
		width: 100%;
		max-width: 140px;
		height: 64px;
		object-fit: contain;
		object-position: left center;
	}

	.engagement__dates {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-items: flex-start;
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.02em;
		color: var(--color-text-secondary);
	}

	.engagement__tag {
		font-size: var(--text-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-primary);
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
		padding: 0.15rem 0.5rem;
	}

	.engagement__role {
		margin: 0 0 0.75rem;
		font-family: var(--font-serif);
		font-size: var(--text-h3);
		line-height: 1.3;
		color: var(--color-text-primary);
	}

	.engagement__desc {
		margin: 0;
		max-width: var(--measure);
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	@media (max-width: 768px) {
		.engagement {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.engagement__dates {
			flex-direction: row;
			align-items: center;
		}
	}
</style>
