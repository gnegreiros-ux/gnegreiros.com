---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { Menu } from '@lucide/astro';
import '../styles/tokens.css';

import { locales } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getLocalizedPath, type Slug } from '../i18n/routes';
import type { Locale } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	/** Language of the rendered content (drives `<html lang>` and nav strings). */
	lang: Locale;
	slug: Slug;
	/** Locale segment of the current URL, if it differs from `lang` (EN-fallback pages served under /fr or /pt-br). */
	routeLocale?: Locale;
}

const { title, description, lang, slug, routeLocale = lang } = Astro.props;
const t = useTranslations(lang);

const navLinks: { slug: Slug; label: string }[] = [
	{ slug: 'approche', label: t('nav.approach') },
	{ slug: 'agentica', label: t('nav.agentica') },
	{ slug: 'dtgen', label: t('nav.dtgen') },
	{ slug: 'parcours', label: t('nav.parcours') },
	{ slug: 'a-propos', label: t('nav.about') },
];

const canonicalUrl = new URL(getLocalizedPath(routeLocale, slug), Astro.site);

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Guilherme Negreiros',
	jobTitle: 'UX Systems Designer',
	url: 'https://gnegreiros.com',
	sameAs: ['https://www.linkedin.com/in/gnegreiros', 'https://github.com/gnegreiros-ux'],
};
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		{locales.map((locale) => (
			<link
				rel="alternate"
				hreflang={locale}
				href={new URL(getLocalizedPath(locale, slug), Astro.site)}
			/>
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath('en', slug), Astro.site)} />

		<script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<nav class="site-nav" aria-label="Primary">
				<a class="site-nav__logo" href={getLocalizedPath(routeLocale, 'home')}>Guilherme Negreiros</a>
				<input type="checkbox" id="nav-toggle" class="site-nav__toggle-input" />
				<label for="nav-toggle" class="site-nav__menu-toggle" aria-label="Open menu">
					<Menu size={22} stroke-width={1.5} aria-hidden="true" />
				</label>
				<ul class="site-nav__links">
					{navLinks.map((link) => (
						<li>
							<a href={getLocalizedPath(routeLocale, link.slug)}>{link.label}</a>
						</li>
					))}
					<li>
						<a class="site-nav__contact" href={getLocalizedPath(routeLocale, 'contact')}>
							{t('nav.contact')}
						</a>
					</li>
				</ul>
			</nav>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} Guilherme Negreiros. {t('footer.rights')}</p>
		</footer>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		background: var(--color-bg);
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text-primary);
		font-family: var(--font-sans);
		font-size: var(--text-body);
		line-height: 1.6;
	}

	a {
		color: inherit;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 100;
		padding: 0.5rem 1rem;
		background: var(--color-bg);
		color: var(--color-text-primary);
	}

	.skip-link:focus {
		left: 0.5rem;
		top: 0.5rem;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--nav-height);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-line);
	}

	.site-nav {
		position: relative;
		max-width: var(--content-max);
		height: 100%;
		margin: 0 auto;
		padding: 0 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.site-nav__logo {
		font-family: var(--font-mono);
		font-size: var(--text-small);
		letter-spacing: 0.02em;
		text-decoration: none;
		white-space: nowrap;
	}

	.site-nav__toggle-input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.site-nav__menu-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: var(--color-text-primary);
	}

	.site-nav__links {
		align-items: center;
		gap: 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: var(--text-small);
	}

	@media (min-width: 769px) {
		.site-nav__links {
			display: flex;
		}
	}

	.site-nav__links a {
		text-decoration: none;
		color: var(--color-text-secondary);
		transition: color 0.2s ease;
	}

	.site-nav__links a:hover,
	.site-nav__links a:focus-visible {
		color: var(--color-text-primary);
	}

	.site-nav__contact {
		color: var(--color-accent) !important;
	}

	main {
		display: block;
	}

	.site-footer {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 2rem 1.5rem;
		text-align: center;
		font-size: var(--text-small);
		color: var(--color-text-secondary);
	}

	@media (max-width: 768px) {
		.site-nav__menu-toggle {
			display: flex;
		}

		.site-nav__links {
			display: none;
			position: absolute;
			top: calc(100% + 1px);
			right: 0;
			left: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			background: var(--color-bg);
			border-bottom: 1px solid var(--color-line);
			font-size: var(--text-mono);
		}

		.site-nav__toggle-input:checked ~ .site-nav__links {
			display: flex;
		}

		.site-nav__links a {
			display: block;
			padding: 0.75rem 1.5rem;
		}
	}
</style>
