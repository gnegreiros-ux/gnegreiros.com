---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AgenticaSections from '../components/AgenticaSections.astro';
import { getAgenticaCopy } from '../content/copy/agentica';
import stats from '../data/agentica-stats.json';

const entry = await getEntry('pages', 'en/agentica');
if (!entry) throw new Error('Missing content entry: en/agentica');
const { copy } = getAgenticaCopy('en');
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="agentica">
	<AgenticaSections
		heroTitle={entry.data.heroTitle}
		heroSubtitle={entry.data.heroSubtitle}
		copy={copy}
		stats={stats}
	/>
</BaseLayout>
