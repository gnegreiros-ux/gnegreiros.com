---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'en/approche');
if (!entry) throw new Error('Missing content entry: en/approche');

const principles = [
	{
		number: '01',
		title: 'Decisions need memory.',
		body: "A design system isn't a component library; it's a record of trade-offs. If you can't explain why a decision was made, you can't safely change it later.",
	},
	{
		number: '02',
		title: 'Workflows are part of the design.',
		body: 'The handoff between design and development is where most systems quietly break down. I treat that pipeline — not just the interface — as something to be designed deliberately.',
	},
	{
		number: '03',
		title: 'Durability beats novelty.',
		body: 'Tools and frameworks turn over every few years. A system built to depend on one tool is a system with an expiration date. I build for standards that outlast the tooling around them.',
	},
];
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="approche">
	<section class="page-hero">
		<div class="dot-mark page-hero__mark" aria-hidden="true"></div>
		<h1 class="page-hero__title">{entry.data.heroTitle}</h1>
		{entry.data.heroSubtitle && <p class="page-hero__subtitle">{entry.data.heroSubtitle}</p>}
	</section>

	<section class="section prose-section">
		<h2 class="section__title">The problem I keep solving</h2>
		<p class="section__body">
			Across public health platforms, insurance systems, and manufacturing tools, I've seen the
			same failure repeat: design decisions get made once, then forgotten. A color changes without
			anyone remembering why the original one was chosen. A component gets rebuilt three times
			because nobody knew it already existed. The system doesn't fail because people are careless —
			it fails because nothing preserves the reasoning behind what was built.
		</p>
	</section>

	<section class="section principles-section">
		<div class="dot-mark principles-section__mark" aria-hidden="true"></div>
		<h2 class="section__title">What I actually optimize for</h2>
		<p class="section__intro">
			My work sits at the intersection of design, development, and operations — what's often
			called DesignOps. Three principles guide it:
		</p>
		<div class="principles__grid">
			{principles.map((principle) => (
				<article class="principle">
					<p class="principle__number">{principle.number}</p>
					<h3 class="principle__title">{principle.title}</h3>
					<p class="principle__body">{principle.body}</p>
				</article>
			))}
		</div>
	</section>

	<section class="section prose-section">
		<h2 class="section__title">How this shows up in practice</h2>
		<p class="section__body">
			At RAMQ, this means building UX foundations for an organization before building screens. At
			Akinox, it meant designing the pipeline between design and development, not just the
			interface on top of it. In Agentica, my personal system, it means every meaningful decision
			is logged, versioned, and traceable — proof that this approach scales beyond a single
			project.
		</p>
	</section>

	<section class="section prose-section ai-section">
		<div class="dot-mark ai-section__mark" aria-hidden="true"></div>
		<h2 class="section__title">Where AI fits</h2>
		<p class="section__body">
			AI agents can accelerate parts of this work — detecting inconsistencies, drafting
			documentation, proposing components. What they can't do is decide. Governance stays human,
			by design. My approach to AI in design systems isn't about automation for its own sake; it's
			about making sure automation never outruns accountability.
		</p>
	</section>
</BaseLayout>

<style>
	.dot-mark {
		position: absolute;
		pointer-events: none;
		background-image: radial-gradient(var(--color-text-secondary) 2px, transparent 2px);
		background-size: 14px 14px;
		opacity: 0.2;
	}

	@media (max-width: 1024px) {
		.dot-mark {
			display: none;
		}
	}

	.page-hero {
		position: relative;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 7.5rem 1.5rem 0;
	}

	.page-hero__mark {
		top: 1.5rem;
		right: 1.5rem;
		width: 180px;
		height: 130px;
	}

	.page-hero__title {
		margin: 0 0 1.5rem;
		font-family: var(--font-serif);
		font-size: var(--text-h1);
		line-height: 1.1;
		color: var(--color-text-primary);
	}

	.page-hero__subtitle {
		margin: 0;
		max-width: var(--measure);
		font-family: var(--font-serif);
		font-size: var(--text-lead);
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.section {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: var(--space-section) 1.5rem 0;
	}

	.prose-section {
		position: relative;
	}

	.section__title {
		margin: 0 0 1.5rem;
		max-width: var(--measure);
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		line-height: 1.2;
		color: var(--color-text-primary);
	}

	.section__body,
	.section__intro {
		margin: 0;
		max-width: var(--measure);
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.section__intro {
		margin-bottom: 2rem;
	}

	.principles-section {
		position: relative;
	}

	.principles-section__mark {
		top: 0;
		right: 1.5rem;
		width: 140px;
		height: 100px;
	}

	.principles__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-card-gap);
	}

	.principle {
		border-left: 2px solid var(--color-accent);
		padding: var(--space-card-padding) 0 0 var(--space-card-padding);
	}

	.principle__number {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.08em;
		color: var(--color-text-secondary);
	}

	.principle__title {
		margin: 0 0 0.75rem;
		font-family: var(--font-serif);
		font-size: var(--text-h3);
		line-height: 1.3;
		color: var(--color-text-primary);
	}

	.principle__body {
		margin: 0;
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.ai-section {
		padding-bottom: var(--space-section);
	}

	.ai-section__mark {
		bottom: 1rem;
		right: 1.5rem;
		width: 140px;
		height: 100px;
	}

	@media (max-width: 768px) {
		.principles__grid {
			grid-template-columns: 1fr;
			gap: var(--space-card-gap-mobile);
		}

		.principle {
			padding-left: calc(var(--space-card-padding) - 0.5rem);
		}
	}
</style>
