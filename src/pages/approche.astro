---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ApprocheSections from '../components/ApprocheSections.astro';
import { getApprocheCopy } from '../content/copy/approche';

const entry = await getEntry('pages', 'en/approche');
if (!entry) throw new Error('Missing content entry: en/approche');
const { copy } = getApprocheCopy('en');
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="approche">
	<ApprocheSections heroTitle={entry.data.heroTitle} heroSubtitle={entry.data.heroSubtitle} copy={copy} />
</BaseLayout>
