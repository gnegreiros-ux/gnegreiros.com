---
import { getEntry } from 'astro:content';
import { ChevronDown } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'en/home');
if (!entry) throw new Error('Missing content entry: en/home');

const teasers = [
	{
		slug: 'approche',
		variant: 'entry' as const,
		eyebrow: 'Approach',
		title: 'How I think about design systems',
		body: "Design systems don't fail because people are careless — they fail because nothing preserves the reasoning behind what was built.",
		linkLabel: 'Read the approach',
	},
	{
		slug: 'agentica',
		variant: 'default' as const,
		eyebrow: 'Agentica',
		title: 'Agentica — proof at scale',
		body: '800+ tokens. 70+ versioned decisions. 14 components shipped, more in progress. A personal system built to test a governance model most enterprise design systems are missing.',
		linkLabel: 'Explore Agentica',
	},
	{
		slug: 'dtgen',
		variant: 'default' as const,
		eyebrow: 'DTGen',
		title: 'DTGen — proof in practice',
		body: "A tool built from a real recurring frustration: generating a coherent token set shouldn't mean starting from a blank page every time.",
		linkLabel: 'See DTGen',
	},
];
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="home">
	<section class="hero">
		<div class="dot-mark hero__mark" aria-hidden="true"></div>
		<div class="hero__grid">
			<p class="hero__annotation">UX Systems Designer / Systems Builder</p>
			<p class="hero__thesis hero__thesis--1">
				I design the decision systems that hold digital experiences together —
			</p>
			<p class="hero__thesis hero__thesis--2">
				for the humans who decide, and now for the <span class="accent-word">AI agents who execute</span>.
			</p>
		</div>
		<div class="hero__divider-wrap">
			<div class="hero__divider"></div>
		</div>
		<div class="hero__footer-wrap">
			<div class="hero__footer">
				<span>20+ years</span>
				<span>Design → Systems → Governance</span>
			</div>
		</div>
		<div class="hero__scroll-hint" aria-hidden="true">
			<ChevronDown size={20} stroke-width={1.5} />
		</div>
	</section>

	<section class="section transition">
		<p class="transition__text">
			Over 20 years, that means moving from screens to the infrastructure behind them — tokens,
			governance, and the workflows that keep decisions consistent long after the people who made
			them have moved on.
		</p>
	</section>

	<section class="section teasers">
		<div class="dot-mark teasers__mark" aria-hidden="true"></div>
		<div class="teasers__grid">
			{teasers.map((teaser) => (
				<article class:list={['teaser', { 'teaser--entry': teaser.variant === 'entry' }]}>
					<p class="teaser__eyebrow">{teaser.eyebrow}</p>
					<h3 class="teaser__title">{teaser.title}</h3>
					<p class="teaser__body">{teaser.body}</p>
					<a class="teaser__link" href={`/${teaser.slug}`}>{teaser.linkLabel} →</a>
				</article>
			))}
		</div>
	</section>

	<section class="section context-teaser">
		<article class="teaser teaser--context">
			<p class="teaser__eyebrow">Parcours</p>
			<h3 class="teaser__title">Tested inside real organizations</h3>
			<p class="teaser__body">
				Public health, insurance, manufacturing — this thinking has been shaped under real
				regulatory and technical constraints, not just in personal projects.
			</p>
			<a class="teaser__link" href="/parcours">See the context →</a>
		</article>
	</section>

	<section class="section final-cta">
		<div class="dot-mark final-cta__mark" aria-hidden="true"></div>
		<p class="final-cta__body">
			If you're evaluating how to make design decisions durable in your organization, I'd be glad
			to talk through what that looks like.
		</p>
		<a class="final-cta__link" href="/contact">Let's talk →</a>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		padding-top: 7.5rem;
		padding-bottom: 3rem;
		min-height: calc(90vh - var(--nav-height));
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
	}

	.dot-mark {
		position: absolute;
		pointer-events: none;
		background-image: radial-gradient(var(--color-text-secondary) 2px, transparent 2px);
		background-size: 14px 14px;
		opacity: 0.2;
	}

	@media (max-width: 1024px) {
		.dot-mark {
			display: none;
		}
	}

	.hero__mark {
		top: 1.5rem;
		right: 1.5rem;
		width: 220px;
		height: 160px;
	}

	.hero__grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 1.5rem;
		max-width: var(--content-max);
		width: 100%;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.hero__annotation {
		grid-column: 1 / -1;
		margin: 0 0 2rem;
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.hero__thesis {
		margin: 0;
		font-family: var(--font-serif);
		font-size: var(--text-hero);
		line-height: 1.05;
		color: var(--color-text-primary);
	}

	.hero__thesis--1 {
		grid-column: 1 / 10;
	}

	.hero__thesis--2 {
		grid-column: 3 / 13;
		margin-top: 0.75em;
		font-size: var(--text-h1);
		line-height: 1.15;
		color: var(--color-text-secondary);
	}

	.accent-word {
		color: var(--color-text-primary);
		transition: color 0.35s ease;
	}

	.hero:hover .accent-word {
		color: var(--color-accent);
	}

	.hero__divider-wrap,
	.hero__footer-wrap {
		max-width: var(--content-max);
		width: 100%;
		margin: 0 auto;
		padding: 0 1.5rem;
		box-sizing: border-box;
	}

	.hero__divider-wrap {
		margin-top: 6rem;
	}

	.hero__divider {
		height: 1px;
		background: var(--color-line);
	}

	.hero__footer-wrap {
		margin-top: 1.5rem;
	}

	.hero__footer {
		display: flex;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.02em;
		color: var(--color-text-secondary);
	}

	.hero__scroll-hint {
		margin: 3rem auto 0;
		color: var(--color-text-secondary);
		animation: bob 2.2s ease-in-out infinite;
	}

	@keyframes bob {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(6px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__scroll-hint {
			animation: none;
		}
	}

	@media (max-width: 768px) {
		.hero__grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.hero__thesis--1,
		.hero__thesis--2 {
			grid-column: 1 / -1;
			margin-top: 0.15em;
		}

		.hero__footer {
			flex-direction: column;
			gap: 1rem;
		}
	}

	.section {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: var(--space-section) 1.5rem 0;
	}

	.transition__text {
		max-width: var(--measure);
		margin: 0 auto;
		font-family: var(--font-serif);
		font-size: var(--text-lead);
		line-height: 1.5;
		color: var(--color-text-secondary);
		text-align: center;
	}

	.teasers {
		position: relative;
	}

	.teasers__mark {
		top: 0;
		right: 1.5rem;
		width: 140px;
		height: 100px;
	}

	.teasers__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-card-gap);
	}

	.teaser__eyebrow {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.teaser__title {
		margin: 0 0 0.75rem;
		font-family: var(--font-serif);
		font-size: var(--text-h3);
		line-height: 1.3;
	}

	.teaser__body {
		margin: 0 0 1.5rem;
		color: var(--color-text-secondary);
		font-size: var(--text-body);
		line-height: 1.6;
	}

	.teaser__link {
		font-size: var(--text-small);
		text-decoration: none;
		color: var(--color-accent);
		font-weight: 500;
	}

	.teaser--entry {
		border-left: 2px solid var(--color-accent);
		padding-left: 1.5rem;
	}

	.context-teaser .teaser--context {
		max-width: var(--measure);
	}

	.final-cta {
		position: relative;
		text-align: center;
		padding-bottom: var(--space-section);
	}

	.final-cta__mark {
		bottom: 1rem;
		right: 1.5rem;
		width: 140px;
		height: 100px;
	}

	.final-cta__body {
		max-width: var(--measure);
		margin: 0 auto 1.5rem;
		font-family: var(--font-serif);
		font-size: var(--text-lead);
		line-height: 1.5;
	}

	.final-cta__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--font-sans);
		font-size: var(--text-h3);
		text-decoration: none;
		color: var(--color-accent);
		font-weight: 500;
	}

	.final-cta__link::after {
		content: '';
		display: inline-block;
		height: 1px;
		width: 2rem;
		background: var(--color-accent);
		transition: width 0.3s ease;
	}

	.final-cta__link:hover::after {
		width: 4rem;
	}

	@media (max-width: 768px) {
		.teasers__grid {
			grid-template-columns: 1fr;
		}

		.teaser--entry {
			padding-left: 1.25rem;
		}
	}
</style>
