---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/HomeSections.astro';
import { homeCopy } from '../content/home-copy';
import stats from '../data/agentica-stats.json';

const entry = await getEntry('pages', 'en/home');
if (!entry) throw new Error('Missing content entry: en/home');
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="home">
	<HomeSections copy={homeCopy.en!} stats={stats} routeLocale="en" />
</BaseLayout>
