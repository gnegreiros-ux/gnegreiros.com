---
import { getEntry } from 'astro:content';
import { Laptop } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'en/dtgen');
if (!entry) throw new Error('Missing content entry: en/dtgen');

const sourceTags = ['Tailwind', 'Ant Design', 'Open Color', 'Custom JSON'];
const colorSpaceTags = ['HSL', 'LCH', 'OKLCH'];

const status = [
	'Supports Tailwind, Ant Design, Open Color, and custom JSON imports',
	'Color generation in HSL, LCH, and OKLCH',
];
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="dtgen">
	<section class="page-hero">
		<div class="dot-mark page-hero__mark" aria-hidden="true"></div>
		<h1 class="page-hero__title">{entry.data.heroTitle}</h1>
		{entry.data.heroSubtitle && <p class="page-hero__subtitle">{entry.data.heroSubtitle}</p>}
	</section>

	<section class="section prose-section">
		<h2 class="section__title">Context / problem</h2>
		<p class="section__body">
			Every new design system starts the same way — a designer manually defining color scales,
			spacing units, and type ratios, one value at a time, with no consistent method for deriving
			them. I built DTGen to remove that friction: a tool that generates a complete, structured
			token set from a small set of inputs, instead of hours of manual guesswork.
		</p>
	</section>

	<section class="section prose-section">
		<h2 class="section__title">What it does</h2>
		<p class="section__body">
			DTGen imports primitives from established sources — Tailwind, Ant Design, Open Color, or a
			custom JSON file — and generates coherent palettes in HSL, LCH, or OKLCH from a handful of
			base colors. It also configures typographic scales using custom ratios, and saves
			configurations for reuse across projects. The goal isn't to replace design judgment; it's to
			remove the repetitive part of the work so that judgment can focus on what actually matters —
			consistency and intent.
		</p>
		<ul class="tags">
			{sourceTags.map((tag) => (
				<li class="tag">{tag}</li>
			))}
			{colorSpaceTags.map((tag) => (
				<li class="tag">{tag}</li>
			))}
		</ul>
	</section>

	<section class="section prose-section">
		<h2 class="section__title">Why it matters</h2>
		<p class="section__body">
			DTGen reflects the same instinct behind Agentica, at a smaller scale: don't solve the same
			foundational problem twice. It's a practical tool built from a real recurring frustration, not
			a theoretical exercise.
		</p>
	</section>

	<section class="section status-section">
		<div class="dot-mark status-section__mark" aria-hidden="true"></div>
		<h2 class="section__title">Status / proof</h2>
		<ul class="results">
			{status.map((line) => (
				<li>{line}</li>
			))}
		</ul>
		<div class="results__links">
			<a class="results__link" href="https://dtgen.netlify.app" target="_blank" rel="noopener">
				<Laptop size={16} stroke-width={1.5} aria-hidden="true" />
				Live beta
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.dot-mark {
		position: absolute;
		pointer-events: none;
		background-image: radial-gradient(var(--color-text-secondary) 2px, transparent 2px);
		background-size: 14px 14px;
		opacity: 0.2;
	}

	@media (max-width: 1024px) {
		.dot-mark {
			display: none;
		}
	}

	.page-hero {
		position: relative;
		max-width: var(--content-max);
		margin: 0 auto;
		padding: 7.5rem 1.5rem 0;
	}

	.page-hero__mark {
		top: 1.5rem;
		right: 1.5rem;
		width: 180px;
		height: 130px;
	}

	.page-hero__title {
		margin: 0 0 1.5rem;
		max-width: 16ch;
		font-family: var(--font-serif);
		font-size: var(--text-h1);
		line-height: 1.1;
		color: var(--color-text-primary);
	}

	.page-hero__subtitle {
		margin: 0;
		max-width: var(--measure);
		font-family: var(--font-serif);
		font-size: var(--text-lead);
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.section {
		max-width: var(--content-max);
		margin: 0 auto;
		padding: var(--space-section) 1.5rem 0;
	}

	.section:last-child {
		padding-bottom: var(--space-section);
	}

	.prose-section,
	.status-section {
		position: relative;
	}

	.section__title {
		margin: 0 0 1.5rem;
		max-width: var(--measure);
		font-family: var(--font-serif);
		font-size: var(--text-h2);
		line-height: 1.2;
		color: var(--color-text-primary);
	}

	.section__body {
		margin: 0;
		max-width: var(--measure);
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
		padding: 0.4rem 0.85rem;
	}

	.status-section__mark {
		top: 0;
		right: 1.5rem;
		width: 160px;
		height: 110px;
	}

	.results {
		max-width: var(--measure);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.results li {
		position: relative;
		padding-left: 1.25rem;
		margin-bottom: 0.75rem;
		font-size: var(--text-body);
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.results li::before {
		content: '—';
		position: absolute;
		left: 0;
		color: var(--color-text-secondary);
	}

	.results__links {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		margin-top: 2rem;
	}

	.results__link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--text-small);
		font-weight: 500;
		text-decoration: none;
		color: var(--color-accent);
	}
</style>
