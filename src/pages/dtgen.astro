---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DtgenSections from '../components/DtgenSections.astro';
import { getDtgenCopy } from '../content/copy/dtgen';

const entry = await getEntry('pages', 'en/dtgen');
if (!entry) throw new Error('Missing content entry: en/dtgen');
const { copy } = getDtgenCopy('en');
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="dtgen">
	<DtgenSections heroTitle={entry.data.heroTitle} heroSubtitle={entry.data.heroSubtitle} copy={copy} />
</BaseLayout>
