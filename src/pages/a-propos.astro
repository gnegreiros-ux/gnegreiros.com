---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AProposSections from '../components/AProposSections.astro';
import { getAProposCopy } from '../content/copy/a-propos';

const entry = await getEntry('pages', 'en/a-propos');
if (!entry) throw new Error('Missing content entry: en/a-propos');
const { copy } = getAProposCopy('en');
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="a-propos">
	<AProposSections heroTitle={entry.data.heroTitle} heroSubtitle={entry.data.heroSubtitle} copy={copy} />
</BaseLayout>
