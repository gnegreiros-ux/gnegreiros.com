---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContentId } from '../../i18n/routes';
import type { Locale } from '../../i18n/ui';

export function getStaticPaths() {
	return [{ params: { locale: 'fr' } }, { params: { locale: 'pt-br' } }];
}

const locale = Astro.params.locale as Locale;

let entry = await getEntry('pages', getContentId(locale, 'home'));
let contentLang: Locale = locale;
if (!entry) {
	entry = await getEntry('pages', getContentId('en', 'home'));
	contentLang = 'en';
}
if (!entry) throw new Error('Missing fallback content entry: en/home');

const { Content } = await render(entry);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	lang={contentLang}
	routeLocale={locale}
	slug="home"
>
	<h1>{entry.data.heroTitle}</h1>
	{entry.data.heroSubtitle && <p>{entry.data.heroSubtitle}</p>}
	<Content />
</BaseLayout>
