---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeSections from '../../components/HomeSections.astro';
import { getContentId } from '../../i18n/routes';
import { getHomeCopy } from '../../content/home-copy';
import type { Locale } from '../../i18n/ui';
import stats from '../../data/agentica-stats.json';

export function getStaticPaths() {
	return [{ params: { locale: 'fr' } }, { params: { locale: 'pt-br' } }];
}

const locale = Astro.params.locale as Locale;

let entry = await getEntry('pages', getContentId(locale, 'home'));
let contentLang: Locale = locale;
if (!entry) {
	entry = await getEntry('pages', getContentId('en', 'home'));
	contentLang = 'en';
}
if (!entry) throw new Error('Missing fallback content entry: en/home');

const { copy } = getHomeCopy(contentLang);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	lang={contentLang}
	routeLocale={locale}
	slug="home"
>
	<HomeSections copy={copy} stats={stats} routeLocale={locale} />
</BaseLayout>
