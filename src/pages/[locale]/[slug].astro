---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContentId, SLUGS, type Slug } from '../../i18n/routes';
import type { Locale } from '../../i18n/ui';

export function getStaticPaths() {
	const locales: Locale[] = ['fr', 'pt-br'];
	const slugs = SLUGS.filter((slug) => slug !== 'home');
	return locales.flatMap((locale) => slugs.map((slug) => ({ params: { locale, slug } })));
}

const locale = Astro.params.locale as Locale;
const slug = Astro.params.slug as Slug;

let entry = await getEntry('pages', getContentId(locale, slug));
let contentLang: Locale = locale;
if (!entry) {
	entry = await getEntry('pages', getContentId('en', slug));
	contentLang = 'en';
}
if (!entry) throw new Error(`Missing fallback content entry: en/${slug}`);

const { Content } = await render(entry);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	lang={contentLang}
	routeLocale={locale}
	slug={slug}
>
	<h1>{entry.data.heroTitle}</h1>
	{entry.data.heroSubtitle && <p>{entry.data.heroSubtitle}</p>}
	<Content />
</BaseLayout>
