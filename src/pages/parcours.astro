---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ParcoursSections from '../components/ParcoursSections.astro';
import { getParcoursCopy } from '../content/copy/parcours';

const entry = await getEntry('pages', 'en/parcours');
if (!entry) throw new Error('Missing content entry: en/parcours');
const { copy } = getParcoursCopy('en');
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="parcours">
	<ParcoursSections heroTitle={entry.data.heroTitle} heroSubtitle={entry.data.heroSubtitle} copy={copy} />
</BaseLayout>
