---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSections from '../components/ContactSections.astro';

const entry = await getEntry('pages', 'en/contact');
if (!entry) throw new Error('Missing content entry: en/contact');
---

<BaseLayout title={entry.data.title} description={entry.data.description} lang="en" slug="contact">
	<ContactSections heroTitle={entry.data.heroTitle} heroSubtitle={entry.data.heroSubtitle} />
</BaseLayout>
