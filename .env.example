# Optional. Only used by `npm run stats:agentica`
# (scripts/update-agentica-stats.mjs), never by `astro build`/`astro dev` —
# the site only reads the committed src/data/agentica-stats.json. Raises
# the GitHub REST rate limit from 60/hr (unauthenticated) to 5,000/hr; not
# required to run the script locally at normal frequency. The scheduled
# CI workflow (.github/workflows/update-agentica-stats.yml) doesn't need
# this set — it uses GitHub Actions' built-in ${{ secrets.GITHUB_TOKEN }}.
GITHUB_TOKEN=
